---
import { REPO, RELEASES, withBase } from "../lib/site.js";
---
<section class="get wrap" id="download">
  <div class="get-bar">
    <div class="get-art"><img src={withBase("app_icon.png")} alt="" width="44" height="44" /></div>
    <div><b>下载 Melodia</b><p>Android 8.0+ 与 Windows 安装包都在 GitHub Releases，免费、开源。</p></div>
    <div class="btn-row">
      <a class="btn btn-primary" href={RELEASES}>前往下载</a>
      <a class="btn btn-ghost" href={REPO}>查看源码</a>
    </div>
  </div>
</section>
