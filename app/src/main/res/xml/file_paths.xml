<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 指定允许分享的缓存目录子路径，对应 cacheDir 中的 logs 文件夹 -->
    <cache-path name="app_logs" path="logs/" />
    <!-- 本地音频内嵌封面提取缓存，对应 cacheDir 中的 local_covers 文件夹 -->
    <cache-path name="local_covers" path="local_covers/" />
    <!-- 歌词分享卡片导出图 -->
    <cache-path name="share_cards" path="share_cards/" />
</paths>
